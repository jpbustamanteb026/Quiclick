{{ 'section-image-responsive-banner.css' | asset_url | stylesheet_tag }}

{%- if section.settings.image_height == 'adapt' and section.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image_mobile.aspect_ratio | default: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{%- style -%}
  #Banner-{{ section.id }}::after {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

{%- liquid
  assign is_first_section = false
  if section.index == 1
    assign is_first_section = true
    assign fetch_priority = 'high'
    assign loading_attr = 'eager'
  else
    assign fetch_priority = 'auto'
    assign loading_attr = 'lazy'
  endif
-%}

<div
  id="Banner-{{ section.id }}"
  class="banner banner--content-align-{{ section.settings.desktop_content_alignment }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment }} banner--{{ section.settings.image_height }}{% if section.settings.image_height == 'adapt' and section.settings.image != blank %} banner--adapt{% endif %}{% if section.settings.show_text_below %} banner--mobile-bottom{%- endif -%}{% if section.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% unless is_first_section %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}{% endunless %}"
>
  {%- if section.settings.image != blank -%}
    <div class="banner__media media{% if section.settings.image_behavior != 'none' and is_first_section == false %} animate--{{ section.settings.image_behavior }}{% endif %}{% unless is_first_section %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}{% endunless %}">
      {%- liquid
        assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
      -%}

      <picture>
        {%- if section.settings.image_mobile != blank -%}
          {%- liquid
            assign image_mobile_height = section.settings.image_mobile.width | divided_by: section.settings.image_mobile.aspect_ratio
            assign mobile_src = section.settings.image_mobile | image_url: width: 750
          -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.image_mobile | image_url: width: 375 }} 375w,
              {{ section.settings.image_mobile | image_url: width: 550 }} 550w,
              {{ section.settings.image_mobile | image_url: width: 750 }} 750w
            "
            sizes="100vw"
            width="{{ section.settings.image_mobile.width }}"
            height="{{ image_mobile_height }}"
          >
        {%- endif -%}

        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            width: section.settings.image.width,
            height: image_height,
            class: 'banner__media-image',
            sizes: '100vw',
            widths: '750, 1100, 1500, 1780, 2000',
            fetchpriority: fetch_priority,
            loading: loading_attr
        }}
      </picture>
    </div>
  {%- else -%}
    <div class="banner__media media placeholder">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}

  <div class="banner__content banner__content--{{ section.settings.desktop_content_position }} page-width{% unless is_first_section %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}{% endunless %}">
    <div class="banner__box content-container content-container--full-width-mobile color-{{ section.settings.color_scheme }} gradient">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2
              class="banner__heading inline-richtext {{ block.settings.heading_size }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.heading }}
            </h2>
          {%- when 'text' -%}
            <div class="banner__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- when 'buttons' -%}
            <div
              class="banner__buttons{% if block.settings.button_label_1 != blank and block.settings.button_label_2 != blank %} banner__buttons--multiple{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  {% if block.settings.button_link_1 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_1 }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}"
                >
                  {{- block.settings.button_label_1 | escape -}}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  {% if block.settings.button_link_2 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_2 }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                >
                  {{- block.settings.button_label_2 | escape -}}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Banner Responsivo",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen para Desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen para Mobile (Opcional)"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Opacidad de superposición",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "Adaptar a la imagen"
        },
        {
          "value": "small",
          "label": "Pequeña"
        },
        {
          "value": "medium",
          "label": "Mediana"
        },
        {
          "value": "large",
          "label": "Grande"
        }
      ],
      "default": "medium",
      "label": "Altura de la imagen"
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        {
          "value": "none",
          "label": "Ninguno"
        },
        {
          "value": "ambient",
          "label": "Movimiento ambiental"
        },
        {
          "value": "fixed",
          "label": "Fijo"
        },
        {
          "value": "zoom-in",
          "label": "Efecto Zoom"
        }
      ],
      "default": "none",
      "label": "Comportamiento de imagen"
    },
    {
      "type": "header",
      "content": "Alineación de contenido Desktop"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        { "value": "top-left", "label": "Arriba a la izquierda" },
        { "value": "top-center", "label": "Arriba al centro" },
        { "value": "top-right", "label": "Arriba a la derecha" },
        { "value": "middle-left", "label": "Centro a la izquierda" },
        { "value": "middle-center", "label": "Centro al medio" },
        { "value": "middle-right", "label": "Centro a la derecha" },
        { "value": "bottom-left", "label": "Abajo a la izquierda" },
        { "value": "bottom-center", "label": "Abajo al centro" },
        { "value": "bottom-right", "label": "Abajo a la derecha" }
      ],
      "default": "middle-center",
      "label": "Posición del contenido"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center",
      "label": "Alineación de texto"
    },
    {
      "type": "checkbox",
      "id": "show_text_box",
      "default": true,
      "label": "Mostrar contenedor de texto"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Ajustes de Mobile"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center",
      "label": "Alineación de texto en mobile"
    },
    {
      "type": "checkbox",
      "id": "show_text_below",
      "default": true,
      "label": "Mostrar texto debajo en mobile"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Título",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Banner de Imagen",
          "label": "Título"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2", "label": "Pequeño" },
            { "value": "h1", "label": "Mediano" },
            { "value": "h0", "label": "Grande" },
            { "value": "hxl", "label": "Extra Grande" }
          ],
          "default": "h1",
          "label": "Tamaño de título"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Describe la promoción o colección actual.",
          "label": "Descripción"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            { "value": "body", "label": "Cuerpo" },
            { "value": "subtitle", "label": "Subtítulo" }
          ],
          "default": "body",
          "label": "Estilo de texto"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Botones",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label_1",
          "default": "Ver más",
          "label": "Texto del botón 1"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "Enlace 1"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_1",
          "default": false,
          "label": "Usar estilo secundario"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Texto del botón 2"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Enlace 2"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_2",
          "default": false,
          "label": "Usar estilo secundario"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner Responsivo Doble Imagen",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}