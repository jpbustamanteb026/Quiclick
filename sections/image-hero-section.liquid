{{ 'component-video-hero.css' | asset_url | stylesheet_tag }}

<div class="content-box group min-h-auto sm:min-h-md">

  <div class="content-box__background-media">
    {%- if section.settings.image_desktop != blank -%}
      <img
        class="image-desktop"
        src="{{ section.settings.image_desktop | image_url: width: 2400 }}"
        alt="{{ section.settings.heading | escape }}"
        width="{{ section.settings.image_desktop.width }}"
        height="{{ section.settings.image_desktop.height }}"
        loading="eager"
      >
    {%- endif -%}

    {%- if section.settings.image_mobile != blank -%}
      <img
        class="image-mobile"
        src="{{ section.settings.image_mobile | image_url: width: 1200 }}"
        alt="{{ section.settings.heading | escape }}"
        width="{{ section.settings.image_mobile.width }}"
        height="{{ section.settings.image_mobile.height }}"
        loading="eager"
      >
    {%- endif -%}
  </div>

  <div class="placement-grid">
    <div class="prose prose-justify-start place-self-start">

      {%- if section.settings.heading != blank -%}
        <p class="h2 sm:h2">{{ section.settings.heading }}</p>
      {%- endif -%}

      {%- if section.settings.text_mobile != blank -%}
        <div class="max-w-sm mobile-block">
          <p>{{ section.settings.text_mobile }}</p>
        </div>
      {%- endif -%}

      {%- if section.settings.text_desktop != blank -%}
        <div class="max-w-sm desktop-block">
          <p>{{ section.settings.text_desktop }}</p>
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a
          class="button"
          style="--button-background: {{ section.settings.button_bg }}; --button-text-color: {{ section.settings.button_text_color }};"
          href="{{ section.settings.button_link }}"
        >
          <button-content class="button__content">{{ section.settings.button_label }}</button-content>
        </a>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image Hero",
  "tag": "section",
  "class": "shopify-section--image-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Imagen Desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen Mobile"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "THE SCENT OF A FRESH START"
    },
    {
      "type": "textarea",
      "id": "text_mobile",
      "label": "Texto (mobile, más corto)",
      "default": "A new warm blend of soft violet, cashmere musk, and creamy sandalwood."
    },
    {
      "type": "textarea",
      "id": "text_desktop",
      "label": "Texto (desktop)",
      "default": "A new warm blend of soft violet, cashmere musk, and creamy sandalwood, inspired by the beauty of new beginnings."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Discover"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link del botón"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Color de fondo del botón",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Color de texto del botón",
      "default": "#1e1e1e"
    }
  ],
  "presets": [
    {
      "name": "Image Hero"
    }
  ]
}
{% endschema %}
